{
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(cat .env)",
      "Bash(cat */.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rclone delete *)",
      "Bash(rclone purge *)",
      "Bash(aws s3 rm *)"
    ]
  }
}
