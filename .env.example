# Nơi đọc dữ liệu Silver: r2 (kho chung) hoặc local (thư mục trên máy)
LAKE_BACKEND=r2
LAKE_SILVER_GLOB=silver/*/*.jsonl
LAKE_LOCAL_ROOT=data/lake

# Cloudflare R2 — điền giá trị thật vào file .env, KHÔNG commit file .env
# Trang kiểm soát chỉ đọc dữ liệu: nên dùng khoá "Object Read only"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vietnam-news-datalake

# Bảo vệ trang bằng mật khẩu — BẮT BUỘC đặt khi mở trang ra Internet (Cloudflare Tunnel, VPS...).
# Để trống thì trang mở tự do, chỉ dùng khi chạy trên máy cá nhân (127.0.0.1).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Web demo sự kiện: thư mục MỘT lần chạy pipeline (để trống = lần chạy ĐẦY ĐỦ mới nhất trong data/runs/, theo
# finished_at trong manifest; bỏ qua run có --start/--end)
EVENTS_RUN_DIR=
# Ẩn tên mô hình của sự kiện giao khoảng ngày này (giờ VN, gồm cả hai ngày) và của sự kiện có tên mô hình gần trùng
# — giữ mù cho tập test đặt tên. Không đặt hoặc để rỗng = mặc định 2026-09-14..2026-09-15.
# Chỉ giá trị `off` mới TẮT ẩn tên (server ghi cảnh báo vào log).
EVENTS_HIDE_NAMES_WINDOW=2026-09-14..2026-09-15
# Nguồn dữ liệu sự kiện của API: files (mặc định, thư mục run ở trên) | db (Postgres DATABASE_URL — tầng sự kiện nạp
# bằng `make db-import-run`; xem docs/tong-hop.md mục 5.2). Hai nguồn trả cùng kết quả cho cùng một run.
EVENTS_BACKEND=files

# ---------------------------------------------------------------------------------------------------
# Postgres — nơi lưu chính của hệ thống chạy liên tục (bài báo, lần cào, đồng hồ). Xem docs/handoff/ingest.md.
# Cách 1: Postgres cài sẵn trên máy (apt, cổng 5432). Tạo role + DB một lần (mật khẩu tự đặt):
#   sudo -u postgres psql -c "CREATE ROLE eventrank LOGIN CREATEDB PASSWORD '<mat-khau>'"
#   sudo -u postgres createdb -O eventrank eventrank            # DB chính (import / crawler)
#   sudo -u postgres createdb -O eventrank eventrank_replay     # DB riêng cho `ingest replay`
# CREATEDB để test tự tạo DB tạm riêng mỗi test rồi xoá (TEST_DATABASE_URL trỏ vào DB bất kỳ của role).
# Cách 2: make db-up (Docker, cổng 5433) — đặt POSTGRES_PASSWORD rồi dùng cổng 5433 trong các URL dưới.
DATABASE_URL=postgresql://eventrank:doi-mat-khau@127.0.0.1:5432/eventrank
# Phát lại Silver vào DB riêng: python -m eventrank.ingest replay --db-env REPLAY_DATABASE_URL …
REPLAY_DATABASE_URL=postgresql://eventrank:doi-mat-khau@127.0.0.1:5432/eventrank_replay
# Test `db` (make test-db): role cần CREATEDB. Bỏ trống → test cần Postgres tự skip.
TEST_DATABASE_URL=

# Tài khoản (apps/api/accounts.py). COOKIE_SECURE: 1/0, để trống = tự bật khi yêu cầu đến qua HTTPS.
# TRUST_PROXY_HEADERS=1 CHỈ khi API đứng sau Cloudflare Tunnel / reverse proxy (đọc IP từ CF-Connecting-IP, X-Forwarded-For).
# PUBLIC_BASE_URL: tiền tố của link trong thư xác minh / đặt lại mật khẩu (để trống = đường dẫn tương đối /verify-email?…).
COOKIE_SECURE=
TRUST_PROXY_HEADERS=
PUBLIC_BASE_URL=
# Chỉ cho make db-up (Docker)
POSTGRES_PASSWORD=

# User-Agent TRUNG THỰC cho crawler (AGENTS.md mục 3) — thiếu thì crawler không chạy. Không giả trình duyệt.
CRAWLER_USER_AGENT="PBL-EventLake/0.1 (nghien cuu sinh vien; +mailto:<email-cua-nhom>)"
