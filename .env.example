# Nơi đọc dữ liệu Silver: r2 (kho chung) hoặc local (thư mục trên máy)
LAKE_BACKEND=r2
LAKE_SILVER_GLOB=silver/*/*.jsonl
LAKE_LOCAL_ROOT=data/lake

# Cloudflare R2 — điền giá trị thật vào file .env, KHÔNG commit file .env
# Trang kiểm soát chỉ đọc dữ liệu: nên dùng khoá "Object Read only"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vietnam-news-datalake

# Bảo vệ trang bằng mật khẩu — BẮT BUỘC đặt khi mở trang ra Internet (Cloudflare Tunnel, VPS...).
# Để trống thì trang mở tự do, chỉ dùng khi chạy trên máy cá nhân (127.0.0.1).
DASHBOARD_USER=
DASHBOARD_PASSWORD=
